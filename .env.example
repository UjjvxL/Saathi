# Copy this file to .env.local and fill in the values.  (cp .env.example .env.local)

# ---------------------------------------------------------------- Required
# MongoDB Atlas: Database -> Connect -> Drivers -> copy the connection string.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=saathi"
MONGODB_DB="saathi"

# Random secret (32+ characters) used to sign login sessions and email links.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=""

# Public address of the app (used in links inside emails). No trailing slash.
# On Vercel you can leave this out: the project's production domain is used automatically.
APP_URL="http://localhost:3000"

# Secret that the scheduler (GitHub Actions, cron-job.org, Vercel Cron or Cloud Scheduler)
# sends to /api/cron/reminders. Generate one with:  openssl rand -hex 32
CRON_SECRET=""

# Optional: how often (seconds) the app checks reminders by itself. Defaults to 60 during
# `npm run dev` and off in production, where a scheduler calls the endpoint instead.
# REMINDER_INTERVAL_SECONDS="60"

# ---------------------------------------------------------------- Email (optional)
# Without these, emails are printed to the server console instead of being sent.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Saathi <your.address@gmail.com>"

# ---------------------------------------------------------------- AI prescription scan (optional)
# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
